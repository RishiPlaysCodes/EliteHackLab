<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - EliteHackLab</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="matrix-bg"></div>
  <div class="lab-container" style="text-align:center; padding-top: 5rem;">
    <h1 style="font-size: 5rem; color: var(--neon-red);">404</h1>
    <h2>Page Not Found</h2>
    <p style="color: var(--text-secondary); margin: 1rem 0;">The page <code><%= url %></code> doesn't exist.</p>
    <p style="color: var(--text-secondary);">Or does it? Maybe you need to look harder... 🔍</p>
    <a href="/" class="btn" style="margin-top: 2rem; display: inline-block;">← Back to Dashboard</a>
  </div>
</body>
</html>
