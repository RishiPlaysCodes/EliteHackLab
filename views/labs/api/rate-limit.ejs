<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-tachometer-alt"></i> Rate Limit Bypass - OTP Brute Force</h1><div class="lab-info"><span class="lab-tag difficulty-medium">Medium</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>The OTP verification endpoint has weak rate limiting. Bypass it to brute force a 4-digit OTP code for the target account admin@hacklab.com.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> OTP Verification</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="otpEmail">Email:</label>
          <input type="text" id="otpEmail" value="admin@hacklab.com" readonly>
        </div>
        <div style="margin-bottom:1rem;">
          <label for="otpCode">OTP Code (4 digits):</label>
          <input type="text" id="otpCode" placeholder="1234" maxlength="4">
        </div>
        <button class="btn" onclick="verifyOtp()"><i class="fas fa-check"></i> Verify OTP</button>
        <button class="btn" onclick="bruteForceOtp()" style="margin-left:0.5rem;"><i class="fas fa-bolt"></i> Brute Force</button>
      </div>
      <div id="otpResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Rate limit bypass techniques:
# - Add X-Forwarded-For with different IPs
# - Use X-Real-IP header rotation
# - Send multiple OTPs in one request (array)
# - Try /api/v2/ vs /api/v1/ endpoints

# OTP range: 0000-9999 (10,000 possibilities)
# 4-digit OTP is trivially brute-forceable
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('api-rate-limit','flagInput_otp','flagResult_otp'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_otp" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_otp" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function verifyOtp() {
      const email = document.getElementById('otpEmail').value;
      const otp = document.getElementById('otpCode').value;
      const resultsDiv = document.getElementById('otpResults');
      try {
        const res = await fetch('/api/labs/api/rate-limit', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ email, otp }) });
        const data = await res.json();
        resultsDiv.innerHTML = '<p style="color:' + (data.success ? '#00ff00' : '#ff4444') + '">' + data.message + '</p>';
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
    async function bruteForceOtp() {
      const resultsDiv = document.getElementById('otpResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Brute forcing OTP (this may take a moment)...</p>';
      const email = document.getElementById('otpEmail').value;
      for (let i = 0; i <= 9999; i += 100) {
        const batch = [];
        for (let j = i; j < Math.min(i + 100, 10000); j++) { batch.push(String(j).padStart(4, '0')); }
        try {
          const res = await fetch('/api/labs/api/rate-limit/brute', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ email, otps: batch }) });
          const data = await res.json();
          if (data.success) { resultsDiv.innerHTML = '<p style="color:#00ff00"><i class="fas fa-check-circle"></i> OTP Found: ' + data.otp + '</p><p>' + (data.flag || '') + '</p>'; return; }
          resultsDiv.innerHTML = '<p style="color:var(--primary)">Tried ' + (i+100) + '/10000...</p>';
        } catch(e) { /* continue */ }
      }
      resultsDiv.innerHTML = '<p style="color:#ff4444">Brute force complete - no match found (try bypass techniques)</p>';
    }
  </script>
</body>
</html>
