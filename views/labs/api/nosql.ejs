<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-database"></i> NoSQL Injection</h1><div class="lab-info"><span class="lab-tag difficulty-medium">Medium</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Bypass the login form using NoSQL injection operators. The backend uses MongoDB and directly passes user input to the query without sanitization.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Login Form</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="nosqlUser">Username:</label>
          <input type="text" id="nosqlUser" placeholder="admin" value="admin">
        </div>
        <div style="margin-bottom:1rem;">
          <label for="nosqlPass">Password:</label>
          <input type="text" id="nosqlPass" placeholder='{"$ne": ""}'>
        </div>
        <div style="margin-bottom:1rem;">
          <label><input type="checkbox" id="nosqlRaw" checked> Send as JSON (not form data)</label>
        </div>
        <button class="btn" onclick="nosqlLogin()"><i class="fas fa-sign-in-alt"></i> Login</button>
      </div>
      <div id="nosqlResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# NoSQL injection operators:
# $ne - not equal
# $gt - greater than
# $regex - regular expression

# Bypass: {"username":"admin","password":{"$ne":""}}
# This matches where password is NOT empty (always true)

# Data extraction with $regex:
# {"username":"admin","password":{"$regex":"^F"}}
# Use to extract the flag character by character
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('api-nosql','flagInput_nosql','flagResult_nosql'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_nosql" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_nosql" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function nosqlLogin() {
      const username = document.getElementById('nosqlUser').value;
      const password = document.getElementById('nosqlPass').value;
      const raw = document.getElementById('nosqlRaw').checked;
      const resultsDiv = document.getElementById('nosqlResults');
      let body;
      if (raw) {
        try { body = JSON.stringify({ username, password: JSON.parse(password) }); } catch(e) { body = JSON.stringify({ username, password }); }
      } else { body = JSON.stringify({ username, password }); }
      try {
        const res = await fetch('/api/labs/api/nosql', { method: 'POST', headers: {'Content-Type':'application/json'}, body });
        const data = await res.json();
        let html = data.success ? '<p style="color:#00ff00"><i class="fas fa-check-circle"></i> Login successful!</p>' : '<p style="color:#ff4444"><i class="fas fa-times-circle"></i> Login failed</p>';
        html += '<pre style="color:var(--text);white-space:pre-wrap;">' + JSON.stringify(data, null, 2) + '</pre>';
        resultsDiv.innerHTML = html;
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
