<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-user-plus"></i> Mass Assignment</h1><div class="lab-info"><span class="lab-tag difficulty-medium">Medium</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>The user registration API blindly accepts all fields from the request body. Add hidden properties to make yourself an admin user.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> API Request Builder</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="massBody">PUT /api/users/profile - Request Body (JSON):</label>
          <textarea id="massBody" rows="8" style="width:100%;background:var(--bg-dark);color:var(--text);border:1px solid var(--primary-dim);padding:0.5rem;font-family:monospace;">{
  "username": "hacker",
  "email": "hacker@test.com",
  "name": "Test User"
}</textarea>
        </div>
        <button class="btn" onclick="sendMassAssign()"><i class="fas fa-paper-plane"></i> Send Request</button>
      </div>
      <div id="massResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Mass assignment: add fields the API doesn't expect
# Common hidden fields:
# "role": "admin"
# "isAdmin": true
# "permissions": ["admin"]
# "verified": true
# "balance": 99999

# Try adding "role": "admin" to your profile update
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('api-mass-assignment','flagInput_mass','flagResult_mass'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_mass" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_mass" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function sendMassAssign() {
      const body = document.getElementById('massBody').value;
      const resultsDiv = document.getElementById('massResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Sending request...</p>';
      try {
        const res = await fetch('/api/labs/api/mass-assignment', { method: 'POST', headers: {'Content-Type':'application/json'}, body: body });
        const data = await res.json();
        let html = '<h4 style="color:var(--primary)">Response:</h4>';
        html += '<pre style="color:var(--text);white-space:pre-wrap;">' + JSON.stringify(data, null, 2) + '</pre>';
        resultsDiv.innerHTML = html;
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
