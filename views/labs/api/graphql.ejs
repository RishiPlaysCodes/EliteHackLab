<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-project-diagram"></i> GraphQL Introspection</h1><div class="lab-info"><span class="lab-tag difficulty-medium">Medium</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Exploit the enabled introspection on the GraphQL endpoint to discover hidden queries and mutations. Find and use the admin mutation to get the flag.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> GraphQL Console</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="gqlQuery">GraphQL Query:</label>
          <textarea id="gqlQuery" rows="8" style="width:100%;background:var(--bg-dark);color:var(--text);border:1px solid var(--primary-dim);padding:0.5rem;font-family:monospace;">{
  __schema {
    queryType { name }
    types { name fields { name } }
  }
}</textarea>
        </div>
        <button class="btn" onclick="sendGraphql()"><i class="fas fa-paper-plane"></i> Execute Query</button>
      </div>
      <div id="gqlResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Introspection query to find all types:
{ __schema { types { name kind fields { name type { name } } } } }

# Find mutations:
{ __schema { mutationType { fields { name args { name type { name } } } } } }

# Look for hidden admin queries or mutations
# Try: mutation { getFlag { flag } }
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('api-graphql','flagInput_gql','flagResult_gql'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_gql" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_gql" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function sendGraphql() {
      const query = document.getElementById('gqlQuery').value;
      const resultsDiv = document.getElementById('gqlResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Executing query...</p>';
      try {
        const res = await fetch('/api/labs/api/graphql', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ query }) });
        const data = await res.json();
        resultsDiv.innerHTML = '<pre style="color:var(--text);white-space:pre-wrap;max-height:400px;overflow-y:auto;">' + JSON.stringify(data, null, 2) + '</pre>';
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
