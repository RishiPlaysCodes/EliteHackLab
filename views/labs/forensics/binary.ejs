<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-microchip"></i> Binary Analysis</h1><div class="lab-info"><span class="lab-tag difficulty-hard">Hard</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Analyze the binary's disassembly to find the hardcoded password check. Reverse engineer the comparison to discover the correct input that prints the flag.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Disassembly Viewer</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="binTool">Analysis Tool:</label>
          <select id="binTool">
            <option value="disasm">Disassemble main()</option>
            <option value="strings">Strings</option>
            <option value="ltrace">ltrace (library calls)</option>
            <option value="strace">strace (system calls)</option>
          </select>
        </div>
        <button class="btn" onclick="analyzeBinary()"><i class="fas fa-search"></i> Analyze</button>
      </div>
      <div id="binResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="vulnerable-form" style="margin-top:1rem;">
        <label for="binInput">Enter Password:</label>
        <input type="text" id="binInput" placeholder="Enter the correct password">
        <button class="btn" onclick="testBinary()" style="margin-top:0.5rem;"><i class="fas fa-play"></i> Run Binary</button>
      </div>
      <div id="binRunResult" class="result-box" style="margin-top:1rem;"></div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('forensics-binary','flagInput_bin','flagResult_bin'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_bin" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_bin" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function analyzeBinary() {
      const tool = document.getElementById('binTool').value;
      const resultsDiv = document.getElementById('binResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Analyzing...</p>';
      try {
        const res = await fetch('/api/labs/forensics/binary', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ tool }) });
        const data = await res.json();
        resultsDiv.innerHTML = '<pre style="color:var(--text);white-space:pre-wrap;max-height:400px;overflow-y:auto;">' + (data.output || 'No output') + '</pre>';
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
    async function testBinary() {
      const input = document.getElementById('binInput').value;
      const resultsDiv = document.getElementById('binRunResult');
      try {
        const res = await fetch('/api/labs/forensics/binary/run', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ input }) });
        const data = await res.json();
        resultsDiv.innerHTML = '<pre style="color:' + (data.success ? '#00ff00' : 'var(--text)') + ';">' + data.output + '</pre>';
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
