<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-memory"></i> Memory Dump Analysis</h1><div class="lab-info"><span class="lab-tag difficulty-hard">Hard</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Analyze the memory dump from a compromised system. Use Volatility-style commands to find running processes, network connections, and extracted credentials.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Memory Analysis</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="volCommand">Volatility Command:</label>
          <select id="volCommand">
            <option value="pslist">pslist (Process List)</option>
            <option value="netscan">netscan (Network Connections)</option>
            <option value="cmdline">cmdline (Command History)</option>
            <option value="hashdump">hashdump (Password Hashes)</option>
            <option value="filescan">filescan (File Handles)</option>
            <option value="dumpfiles">dumpfiles (Extract Files)</option>
          </select>
        </div>
        <button class="btn" onclick="runVolatility()"><i class="fas fa-play"></i> Execute</button>
      </div>
      <div id="memResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Volatility workflow:
vol.py -f memdump.raw imageinfo
vol.py -f memdump.raw --profile=Win7SP1x64 pslist
vol.py -f memdump.raw --profile=Win7SP1x64 netscan
vol.py -f memdump.raw --profile=Win7SP1x64 hashdump

# Look for: suspicious processes, C2 connections, dumped creds
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('forensics-memory','flagInput_mem','flagResult_mem'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_mem" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_mem" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function runVolatility() {
      const command = document.getElementById('volCommand').value;
      const resultsDiv = document.getElementById('memResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Running vol.py ' + command + '...</p>';
      try {
        const res = await fetch('/api/labs/forensics/memory', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ command }) });
        const data = await res.json();
        resultsDiv.innerHTML = '<pre style="color:var(--text);white-space:pre-wrap;max-height:400px;overflow-y:auto;">' + (data.output || 'No output') + '</pre>';
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
