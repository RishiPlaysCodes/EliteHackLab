<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-code"></i> Encoding Challenges</h1><div class="lab-info"><span class="lab-tag difficulty-easy">Easy</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Decode the following encoded messages. Each uses a different encoding scheme. Decode all of them to assemble the final flag.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Decoder</h2>
      <div class="code-block">
        <h4>Encoded Messages:</h4>
        <pre>
1. Base64:  RkxBR3tlbmMwZDFuZ18=
2. Hex:     6d3473743372
3. ROT13:   vf5f756e
4. Binary:  01011111 01100110 01110101 01101110
5. URL:     %7D
        </pre>
      </div>
      <div class="vulnerable-form" style="margin-top:1rem;">
        <div style="margin-bottom:1rem;">
          <label for="encInput">Input:</label>
          <input type="text" id="encInput" placeholder="Enter encoded text">
        </div>
        <div style="margin-bottom:1rem;">
          <label for="encType">Encoding Type:</label>
          <select id="encType">
            <option value="base64">Base64 Decode</option>
            <option value="hex">Hex Decode</option>
            <option value="rot13">ROT13</option>
            <option value="binary">Binary Decode</option>
            <option value="url">URL Decode</option>
          </select>
        </div>
        <button class="btn" onclick="decodeInput()"><i class="fas fa-unlock"></i> Decode</button>
      </div>
      <div id="encResults" class="result-box" style="margin-top:1rem;"></div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('forensics-encoding','flagInput_enc','flagResult_enc'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_enc" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_enc" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function decodeInput() {
      const input = document.getElementById('encInput').value;
      const type = document.getElementById('encType').value;
      const resultsDiv = document.getElementById('encResults');
      try {
        const res = await fetch('/api/labs/forensics/encoding', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ input, type }) });
        const data = await res.json();
        resultsDiv.innerHTML = '<h4 style="color:var(--primary)">Decoded:</h4><p style="font-family:monospace;color:#00ff00;">' + (data.decoded || 'Error') + '</p>';
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
