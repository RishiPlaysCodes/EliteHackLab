<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-file-alt"></i> Log Analysis</h1><div class="lab-info"><span class="lab-tag difficulty-medium">Medium</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Analyze the web server logs to identify the attack pattern. Find the attacker's IP, the vulnerability exploited, and the data exfiltrated.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Log Viewer</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="logFilter">Filter:</label>
          <select id="logFilter">
            <option value="all">All Entries</option>
            <option value="4xx">4xx Errors</option>
            <option value="5xx">5xx Errors</option>
            <option value="sql">SQL Injection Attempts</option>
            <option value="xss">XSS Attempts</option>
            <option value="brute">Brute Force</option>
          </select>
        </div>
        <button class="btn" onclick="filterLogs()"><i class="fas fa-filter"></i> Filter Logs</button>
      </div>
      <div id="logResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="vulnerable-form" style="margin-top:1rem;">
        <h4>Investigation Questions:</h4>
        <div style="margin-bottom:0.5rem;">
          <label for="attackerIp">Attacker's IP:</label>
          <input type="text" id="attackerIp" placeholder="x.x.x.x">
        </div>
        <div style="margin-bottom:0.5rem;">
          <label for="attackType">Attack Type:</label>
          <input type="text" id="attackType" placeholder="SQL Injection / XSS / etc">
        </div>
        <button class="btn" onclick="submitAnalysis()"><i class="fas fa-check"></i> Submit Analysis</button>
      </div>
      <div id="analysisResult" class="result-box" style="margin-top:1rem;"></div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('forensics-log-analysis','flagInput_logs','flagResult_logs'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_logs" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_logs" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function filterLogs() {
      const filter = document.getElementById('logFilter').value;
      const resultsDiv = document.getElementById('logResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Loading logs...</p>';
      try {
        const res = await fetch('/api/labs/forensics/log-analysis', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ filter }) });
        const data = await res.json();
        resultsDiv.innerHTML = '<pre style="color:var(--text);white-space:pre-wrap;max-height:300px;overflow-y:auto;">' + (data.logs || 'No entries') + '</pre>';
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
    async function submitAnalysis() {
      const ip = document.getElementById('attackerIp').value;
      const type = document.getElementById('attackType').value;
      const resultsDiv = document.getElementById('analysisResult');
      try {
        const res = await fetch('/api/labs/forensics/log-analysis/verify', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ attackerIp: ip, attackType: type }) });
        const data = await res.json();
        resultsDiv.innerHTML = data.correct ? '<p style="color:#00ff00"><i class="fas fa-check-circle"></i> ' + data.message + '</p>' : '<p style="color:#ff4444"><i class="fas fa-times-circle"></i> ' + data.message + '</p>';
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
