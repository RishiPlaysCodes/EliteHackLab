<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-bug"></i> Kernel Exploits</h1><div class="lab-info"><span class="lab-tag difficulty-hard">Hard</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Identify the kernel version and find applicable kernel exploits. Use the system information to select the correct exploit and gain root access.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> System Enumeration</h2>
      <div class="code-block">
        <h4>System Info:</h4>
        <pre>
<% if (systemInfo) { %>
Kernel: <%= systemInfo.kernel || 'Linux 3.13.0-24-generic' %>
OS: <%= systemInfo.os || 'Ubuntu 14.04 LTS' %>
Arch: <%= systemInfo.arch || 'x86_64' %>
<% } %>
        </pre>
      </div>
      <div class="vulnerable-form" style="margin-top:1rem;">
        <div style="margin-bottom:1rem;">
          <label for="exploitSelect">Select Exploit:</label>
          <select id="exploitSelect">
            <option value="dirtycow">DirtyCOW (CVE-2016-5195)</option>
            <option value="dirtypipe">DirtyPipe (CVE-2022-0847)</option>
            <option value="overlayfs">OverlayFS (CVE-2015-1328)</option>
            <option value="pkexec">PwnKit (CVE-2021-4034)</option>
          </select>
        </div>
        <button class="btn" onclick="runExploit()"><i class="fas fa-bomb"></i> Compile & Run</button>
      </div>
      <div id="kernelResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Enumeration:
uname -a
cat /etc/os-release
linux-exploit-suggester.sh

# The kernel version determines which exploits work
# Match the version to known CVEs
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('privesc-kernel','flagInput_kernel','flagResult_kernel'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_kernel" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_kernel" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function runExploit() {
      const exploit = document.getElementById('exploitSelect').value;
      const resultsDiv = document.getElementById('kernelResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Compiling and running exploit...</p>';
      try {
        const res = await fetch('/api/labs/privesc/kernel', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ exploit }) });
        const data = await res.json();
        resultsDiv.innerHTML = '<pre style="color:' + (data.success ? '#00ff00' : 'var(--text)') + ';white-space:pre-wrap;">' + (data.output || data.error) + '</pre>';
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
