<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-user-shield"></i> IAM Privilege Escalation</h1><div class="lab-info"><span class="lab-tag difficulty-hard">Hard</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Starting with a low-privilege IAM user, find and exploit misconfigurations to escalate to admin. Enumerate your permissions and discover paths to higher privileges.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> IAM Console</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="iamCommand">AWS CLI Command:</label>
          <input type="text" id="iamCommand" placeholder="aws iam get-user" value="aws iam get-user">
        </div>
        <button class="btn" onclick="runIamCmd()"><i class="fas fa-play"></i> Execute</button>
      </div>
      <div id="iamResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Enumeration:
aws iam get-user
aws iam list-attached-user-policies --user-name USERNAME
aws iam list-user-policies --user-name USERNAME
aws iam list-roles

# Privilege escalation paths:
# - iam:CreatePolicyVersion
# - iam:AttachUserPolicy
# - iam:PutUserPolicy
# - sts:AssumeRole (to admin role)
# - lambda:CreateFunction + iam:PassRole
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('cloud-iam','flagInput_iam','flagResult_iam'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_iam" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_iam" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function runIamCmd() {
      const command = document.getElementById('iamCommand').value;
      const resultsDiv = document.getElementById('iamResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Executing...</p>';
      try {
        const res = await fetch('/api/labs/cloud/iam', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ command }) });
        const data = await res.json();
        resultsDiv.innerHTML = '<pre style="color:var(--text);white-space:pre-wrap;">' + (data.output || data.error || 'No output') + '</pre>';
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
