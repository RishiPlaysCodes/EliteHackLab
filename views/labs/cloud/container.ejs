<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fab fa-docker"></i> Container Escape</h1><div class="lab-info"><span class="lab-tag difficulty-hard">Hard</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>You are inside a misconfigured Docker container. Find a way to escape the container and access the host filesystem. Identify dangerous capabilities and mounted volumes.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Container Shell</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="containerCmd">Command:</label>
          <input type="text" id="containerCmd" placeholder="ls /" value="id">
        </div>
        <button class="btn" onclick="runContainerCmd()"><i class="fas fa-play"></i> Execute</button>
      </div>
      <div id="containerResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Check if you're in a container:
cat /proc/1/cgroup
ls /.dockerenv

# Look for escape vectors:
mount | grep docker
fdisk -l                    # Check for host disks
capsh --print               # Check capabilities
cat /proc/self/status | grep Cap

# Dangerous capabilities:
# CAP_SYS_ADMIN, CAP_NET_ADMIN, CAP_SYS_PTRACE

# Docker socket mounted?
ls -la /var/run/docker.sock
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('cloud-container','flagInput_container','flagResult_container'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_container" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_container" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function runContainerCmd() {
      const command = document.getElementById('containerCmd').value;
      const resultsDiv = document.getElementById('containerResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Executing in container...</p>';
      try {
        const res = await fetch('/api/labs/cloud/container', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ command }) });
        const data = await res.json();
        resultsDiv.innerHTML = '<pre style="color:var(--text);white-space:pre-wrap;">' + (data.output || data.error || 'No output') + '</pre>';
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
