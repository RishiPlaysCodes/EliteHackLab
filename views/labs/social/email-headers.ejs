<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-envelope-open-text"></i> Email Header Analysis</h1><div class="lab-info"><span class="lab-tag difficulty-medium">Medium</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Analyze the email headers below to determine the true origin of the message. Identify if the email is spoofed and find the actual sending IP address.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Email Headers</h2>
      <div class="code-block">
        <pre style="max-height:400px;overflow-y:auto;white-space:pre-wrap;"><%= headers %></pre>
      </div>
      <div class="vulnerable-form" style="margin-top:1rem;">
        <div style="margin-bottom:1rem;">
          <label for="senderIp">True Sender IP Address:</label>
          <input type="text" id="senderIp" placeholder="x.x.x.x">
        </div>
        <div style="margin-bottom:1rem;">
          <label for="spoofed">Is this email spoofed?</label>
          <select id="spoofed">
            <option value="yes">Yes - Spoofed</option>
            <option value="no">No - Legitimate</option>
          </select>
        </div>
        <button class="btn" onclick="analyzeHeaders()"><i class="fas fa-search"></i> Submit Analysis</button>
      </div>
      <div id="headerResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Key headers to examine:
# Received: (trace the email path, bottom-up)
# Return-Path: (actual sender)
# X-Originating-IP: (sender's IP)
# SPF/DKIM/DMARC results
# Reply-To vs From mismatch
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('social-email-headers','flagInput_headers','flagResult_headers'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_headers" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_headers" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function analyzeHeaders() {
      const senderIp = document.getElementById('senderIp').value;
      const spoofed = document.getElementById('spoofed').value;
      const resultsDiv = document.getElementById('headerResults');
      try {
        const res = await fetch('/api/labs/social/email-headers', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ senderIp, spoofed }) });
        const data = await res.json();
        if (data.correct) { resultsDiv.innerHTML = '<p style="color:#00ff00"><i class="fas fa-check-circle"></i> Correct! ' + data.message + '</p>'; }
        else { resultsDiv.innerHTML = '<p style="color:#ff4444"><i class="fas fa-times-circle"></i> ' + data.message + '</p>'; }
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
