<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-binoculars"></i> OSINT Challenge</h1><div class="lab-info"><span class="lab-tag difficulty-medium">Medium</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Use Open Source Intelligence techniques to gather information about the target organization "HackCorp Inc." Find their leaked credentials, employee details, and infrastructure information.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> OSINT Tools</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="osintTool">Tool:</label>
          <select id="osintTool">
            <option value="whois">WHOIS Lookup</option>
            <option value="google-dork">Google Dorking</option>
            <option value="shodan">Shodan Search</option>
            <option value="github">GitHub Search</option>
            <option value="pastebin">Pastebin Search</option>
          </select>
        </div>
        <div style="margin-bottom:1rem;">
          <label for="osintQuery">Search Query:</label>
          <input type="text" id="osintQuery" placeholder="hackcorp.com" value="hackcorp.com">
        </div>
        <button class="btn" onclick="runOsint()"><i class="fas fa-search"></i> Search</button>
      </div>
      <div id="osintResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# OSINT techniques:
# WHOIS: Domain registration info
# Google Dorks: site:hackcorp.com filetype:pdf
# Shodan: Search for exposed services
# GitHub: "hackcorp" password OR secret OR key
# Pastebin: Leaked credentials

# Combine findings to get the full picture
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('social-osint','flagInput_osint','flagResult_osint'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_osint" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_osint" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function runOsint() {
      const tool = document.getElementById('osintTool').value;
      const query = document.getElementById('osintQuery').value;
      const resultsDiv = document.getElementById('osintResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Searching...</p>';
      try {
        const res = await fetch('/api/labs/social/osint', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ tool, query }) });
        const data = await res.json();
        let html = '<h4 style="color:var(--primary)">' + tool.toUpperCase() + ' Results:</h4>';
        html += '<pre style="color:var(--text);white-space:pre-wrap;">' + (data.results || data.error || 'No results') + '</pre>';
        resultsDiv.innerHTML = html;
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
