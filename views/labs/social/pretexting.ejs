<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-theater-masks"></i> Pretexting Scenarios</h1><div class="lab-info"><span class="lab-tag difficulty-medium">Medium</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Practice creating convincing pretexts to extract information from a simulated help desk. Choose the right approach and persona to get the target to reveal sensitive information.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Help Desk Simulation</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="persona">Your Persona:</label>
          <select id="persona">
            <option value="it-admin">IT Administrator</option>
            <option value="executive">Company Executive</option>
            <option value="vendor">External Vendor</option>
            <option value="new-employee">New Employee</option>
          </select>
        </div>
        <div style="margin-bottom:1rem;">
          <label for="pretextMsg">Your Message to Help Desk:</label>
          <textarea id="pretextMsg" rows="4" style="width:100%;background:var(--bg-dark);color:var(--text);border:1px solid var(--primary-dim);padding:0.5rem;" placeholder="Hi, I need to reset the password for..."></textarea>
        </div>
        <button class="btn" onclick="sendPretext()"><i class="fas fa-paper-plane"></i> Send Message</button>
      </div>
      <div id="pretextResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Pretexting techniques:
# - Authority: Pretend to be someone in power
# - Urgency: Create time pressure
# - Helpfulness: Offer to help solve a problem
# - Technical jargon: Sound knowledgeable

# Goal: Get the help desk to reveal admin credentials
# Try: "This is urgent, the CEO needs access..."
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('social-pretexting','flagInput_pretext','flagResult_pretext'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_pretext" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_pretext" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function sendPretext() {
      const persona = document.getElementById('persona').value;
      const message = document.getElementById('pretextMsg').value;
      const resultsDiv = document.getElementById('pretextResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Sending...</p>';
      try {
        const res = await fetch('/api/labs/social/pretexting', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ persona, message }) });
        const data = await res.json();
        let html = '<h4 style="color:var(--primary)">Help Desk Response:</h4>';
        html += '<p style="color:var(--text);white-space:pre-wrap;">' + data.response + '</p>';
        if (data.flag) html += '<p style="color:#00ff00;margin-top:0.5rem;">' + data.flag + '</p>';
        resultsDiv.innerHTML = html;
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
