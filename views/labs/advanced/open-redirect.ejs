<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-external-link-alt"></i> Open Redirect</h1><div class="lab-info"><span class="lab-tag difficulty-easy">Easy</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Find and exploit the open redirect vulnerability in the login flow. Craft a URL that redirects users to an attacker-controlled domain after authentication.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Redirect Tester</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="redirectUrl">Redirect URL Parameter:</label>
          <input type="text" id="redirectUrl" placeholder="https://evil.com" value="/dashboard">
        </div>
        <button class="btn" onclick="testRedirect()"><i class="fas fa-link"></i> Test Redirect</button>
      </div>
      <div id="redirectResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Bypass techniques for redirect validation:
# https://evil.com (direct external URL)
# //evil.com (protocol-relative URL)
# /\evil.com (backslash trick)
# https://hacklab.com@evil.com (URL with auth)
# https://hacklab.com.evil.com (subdomain)
# /%0d%0aLocation:%20https://evil.com (CRLF)
# /redirect?url=https://evil.com (double redirect)

# The flag is revealed when you redirect to evil.com
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('advanced-open-redirect','flagInput_redirect','flagResult_redirect'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_redirect" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_redirect" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function testRedirect() {
      const url = document.getElementById('redirectUrl').value;
      const resultsDiv = document.getElementById('redirectResults');
      try {
        const res = await fetch('/api/labs/advanced/open-redirect', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ url }) });
        const data = await res.json();
        let html = '<h4 style="color:var(--primary)">Redirect Analysis:</h4>';
        html += '<p>Redirect Location: <span style="color:' + (data.external ? '#00ff00' : 'var(--text)') + ';">' + data.location + '</span></p>';
        if (data.external) html += '<p style="color:#00ff00"><i class="fas fa-exclamation-triangle"></i> Open redirect found! Redirects to external domain.</p>';
        if (data.flag) html += '<p style="color:#00ff00">' + data.flag + '</p>';
        resultsDiv.innerHTML = html;
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
