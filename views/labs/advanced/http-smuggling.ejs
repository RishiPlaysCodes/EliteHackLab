<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-ship"></i> HTTP Request Smuggling</h1><div class="lab-info"><span class="lab-tag difficulty-hard">Hard</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Exploit the discrepancy between front-end and back-end servers in parsing HTTP request boundaries. Use CL.TE or TE.CL smuggling to access the admin panel.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Request Builder</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="smuggleType">Smuggling Type:</label>
          <select id="smuggleType">
            <option value="cl-te">CL.TE (Content-Length vs Transfer-Encoding)</option>
            <option value="te-cl">TE.CL (Transfer-Encoding vs Content-Length)</option>
            <option value="te-te">TE.TE (Transfer-Encoding obfuscation)</option>
          </select>
        </div>
        <div style="margin-bottom:1rem;">
          <label for="smugglePayload">Raw HTTP Request:</label>
          <textarea id="smugglePayload" rows="10" style="width:100%;background:var(--bg-dark);color:var(--text);border:1px solid var(--primary-dim);padding:0.5rem;font-family:monospace;">POST / HTTP/1.1
Host: hacklab.com
Content-Length: 13
Transfer-Encoding: chunked

0

GET /admin HTTP/1.1
Host: hacklab.com</textarea>
        </div>
        <button class="btn" onclick="sendSmuggle()"><i class="fas fa-paper-plane"></i> Send Request</button>
      </div>
      <div id="smuggleResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# CL.TE: Front-end uses Content-Length, back-end uses Transfer-Encoding
# TE.CL: Front-end uses Transfer-Encoding, back-end uses Content-Length

# The smuggled request piggybacks on the next user's request
# Use this to access /admin which is restricted by the front-end
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('advanced-http-smuggling','flagInput_smuggle','flagResult_smuggle'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_smuggle" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_smuggle" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function sendSmuggle() {
      const type = document.getElementById('smuggleType').value;
      const payload = document.getElementById('smugglePayload').value;
      const resultsDiv = document.getElementById('smuggleResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Sending smuggled request...</p>';
      try {
        const res = await fetch('/api/labs/advanced/http-smuggling', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ type, payload }) });
        const data = await res.json();
        let html = '<h4 style="color:var(--primary)">Server Response:</h4>';
        html += '<pre style="color:var(--text);white-space:pre-wrap;">' + (data.response || data.error) + '</pre>';
        resultsDiv.innerHTML = html;
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
