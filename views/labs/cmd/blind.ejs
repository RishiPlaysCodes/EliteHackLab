<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Blind CMD Injection - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1>⚡ Blind Command Injection</h1><div class="lab-info"><span class="lab-tag difficulty-hard">Hard</span></div></div>
    <div class="lab-section">
      <h2><i class="fas fa-crosshairs"></i> Objective</h2>
      <p>This form sends an email notification. The email address is used in a command, but you don't see the output. Use time-based detection (sleep) to confirm injection.</p>
    </div>
    <div class="lab-section">
      <h2><i class="fas fa-terminal"></i> Email Notification</h2>
      <div class="vulnerable-form">
        <label>Email address:</label>
        <input type="text" id="emailInput" placeholder="user@test.com; sleep 5" autocomplete="off">
        <button onclick="testBlindCmd()" class="btn">Send Notification</button>
      </div>
      <div id="blindCmdResult" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">Time-based payloads:
user@test.com; sleep 3
user@test.com | sleep 5
user@test.com && sleep 2

If response takes longer → injection confirmed!</div>
    </div>
    <div class="flag-submit">
      <h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('cmd-injection','flagInput_cmd2','flagResult_cmd2'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_cmd2" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_cmd2" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function testBlindCmd() {
      const start = Date.now();
      const res = await fetch('/labs/cmd-injection/blind/submit', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({email:document.getElementById('emailInput').value}) });
      const data = await res.json();
      const elapsed = Date.now() - start;
      document.getElementById('blindCmdResult').innerHTML = `<pre>Response time: ${elapsed}ms\n${JSON.stringify(data,null,2)}</pre>`;
    }
  </script>
</body>
</html>
