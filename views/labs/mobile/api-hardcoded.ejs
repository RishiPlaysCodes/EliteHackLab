<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-file-code"></i> Hardcoded API Keys</h1><div class="lab-info"><span class="lab-tag difficulty-easy">Easy</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Decompile the APK and search for hardcoded secrets. Find API keys, tokens, and credentials embedded in the source code and configuration files.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> APK Decompilation Results</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="searchPattern">Search Pattern (grep):</label>
          <input type="text" id="searchPattern" placeholder="api_key|secret|token" value="api_key|secret|token">
        </div>
        <button class="btn" onclick="searchApk()"><i class="fas fa-search"></i> Search Decompiled Code</button>
      </div>
      <div id="apkResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Decompilation tools:
apktool d app.apk              # Decompile APK
jadx -d output app.apk         # Java decompiler
strings app.apk | grep -i key  # Quick string search

# Search patterns:
grep -r "api_key\|API_KEY\|secret\|password" .
grep -r "https://\|http://" .
# Check: AndroidManifest.xml, strings.xml, BuildConfig
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('mobile-api-hardcoded','flagInput_apk','flagResult_apk'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_apk" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_apk" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function searchApk() {
      const pattern = document.getElementById('searchPattern').value;
      const resultsDiv = document.getElementById('apkResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Searching decompiled source...</p>';
      try {
        const res = await fetch('/api/labs/mobile/api-hardcoded', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ pattern }) });
        const data = await res.json();
        let html = '<h4 style="color:var(--primary)">Search Results:</h4>';
        html += '<pre style="color:var(--text);white-space:pre-wrap;">' + (data.results || 'No matches found') + '</pre>';
        resultsDiv.innerHTML = html;
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
