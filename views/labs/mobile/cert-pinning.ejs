<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-certificate"></i> Certificate Pinning Bypass</h1><div class="lab-info"><span class="lab-tag difficulty-hard">Hard</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>The mobile app implements certificate pinning. Bypass it using Frida to intercept HTTPS traffic and discover the hidden API endpoint containing the flag.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Frida Console</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="fridaScript">Frida Script:</label>
          <textarea id="fridaScript" rows="8" style="width:100%;background:var(--bg-dark);color:var(--text);border:1px solid var(--primary-dim);padding:0.5rem;font-family:monospace;">Java.perform(function() {
  var TrustManager = Java.use('com.hacklab.app.SSLPinning');
  TrustManager.verify.implementation = function() {
    console.log('[*] Certificate pinning bypassed!');
    return true;
  };
});</textarea>
        </div>
        <button class="btn" onclick="runFrida()"><i class="fas fa-play"></i> Execute Script</button>
      </div>
      <div id="fridaResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Frida SSL pinning bypass:
frida -U -f com.hacklab.app -l bypass.js

# Common pinning implementations:
# - OkHttp CertificatePinner
# - TrustManagerImpl
# - Network Security Config

# After bypass, intercept with mitmproxy
# Look for /api/secret endpoint in traffic
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('mobile-cert-pinning','flagInput_cert','flagResult_cert'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_cert" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_cert" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function runFrida() {
      const script = document.getElementById('fridaScript').value;
      const resultsDiv = document.getElementById('fridaResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Injecting Frida script...</p>';
      try {
        const res = await fetch('/api/labs/mobile/cert-pinning', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ script }) });
        const data = await res.json();
        let html = '<h4 style="color:var(--primary)">Frida Output:</h4>';
        html += '<pre style="color:#00ff00;white-space:pre-wrap;">' + (data.output || 'No output') + '</pre>';
        if (data.intercepted) { html += '<h4 style="color:var(--primary);margin-top:1rem;">Intercepted Traffic:</h4><pre style="color:var(--text);white-space:pre-wrap;">' + data.intercepted + '</pre>'; }
        resultsDiv.innerHTML = html;
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
