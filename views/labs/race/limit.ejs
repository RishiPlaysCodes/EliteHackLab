<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1>⚡ Limit Bypass via Race</h1><div class="lab-info"><span class="lab-tag difficulty-hard">Hard</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Daily transfer limit is 3. Exceed it by sending multiple transfers simultaneously before the counter updates.</p></div>
    <div class="lab-section">
      <h2><i class="fas fa-terminal"></i> Transfer System (Limit: 3/day)</h2>
      <div class="vulnerable-form">
        <label>Concurrent Transfers:</label><input type="number" id="limitCount" value="10" min="4" max="20">
        <button onclick="raceLimit()" class="btn btn-danger">⚡ Race Transfers</button>
      </div>
      <div id="limitResult" class="result-box" style="margin-top:1rem;"></div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('race-condition','flagInput_rc3','flagResult_rc3'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_rc3" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_rc3" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function raceLimit(){const n=document.getElementById('limitCount').value;const p=[];for(let i=0;i<n;i++)p.push(fetch('/labs/race-condition/limit/transfer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({})}));const results=await Promise.all(p);const data=await Promise.all(results.map(r=>r.json()));document.getElementById('limitResult').innerHTML='<pre>'+JSON.stringify(data,null,2)+'</pre>';}
  </script>
</body>
</html>
