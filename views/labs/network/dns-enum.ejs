<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-globe"></i> DNS Enumeration</h1><div class="lab-info"><span class="lab-tag difficulty-medium">Medium</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Enumerate DNS records for the target domain. Find hidden subdomains and services by querying different record types. The flag is hidden in one of the TXT records.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> DNS Lookup</h2>
      <div class="vulnerable-form">
        <div style="margin-bottom:1rem;">
          <label for="domainInput">Target Domain:</label>
          <input type="text" id="domainInput" placeholder="example.com" value="hacklab.local">
        </div>
        <div style="margin-bottom:1rem;">
          <label for="recordType">Record Type:</label>
          <select id="recordType">
            <option value="A">A (Address)</option>
            <option value="MX">MX (Mail Exchange)</option>
            <option value="TXT">TXT (Text)</option>
            <option value="NS">NS (Name Server)</option>
            <option value="AXFR">AXFR (Zone Transfer)</option>
          </select>
        </div>
        <button class="btn" onclick="queryDns()"><i class="fas fa-search"></i> Query DNS</button>
      </div>
      <div id="dnsResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# DNS enumeration commands:
dig hacklab.local A          # Get A records
dig hacklab.local MX         # Get mail servers
dig hacklab.local TXT        # Get TXT records (SPF, DKIM, etc)
dig hacklab.local NS         # Get nameservers
dig @ns1.hacklab.local hacklab.local AXFR  # Zone transfer

# TXT records often contain verification tokens and secrets
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('network-dns-enum','flagInput_dns','flagResult_dns'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_dns" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_dns" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function queryDns() {
      const domain = document.getElementById('domainInput').value;
      const recordType = document.getElementById('recordType').value;
      const resultsDiv = document.getElementById('dnsResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Querying ' + recordType + ' records for ' + domain + '...</p>';
      try {
        const res = await fetch('/api/labs/network/dns-enum', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ domain, recordType })
        });
        const data = await res.json();
        if (data.records) {
          let html = '<h4 style="color:var(--primary)">' + recordType + ' Records for ' + domain + '</h4>';
          html += '<div style="font-family:monospace; margin-top:0.5rem;">';
          data.records.forEach(function(r) {
            html += '<p style="margin:0.25rem 0; color:var(--text)">' + r + '</p>';
          });
          html += '</div>';
          resultsDiv.innerHTML = html;
        } else {
          resultsDiv.innerHTML = '<p style="color:#ff4444">' + (data.error || 'No records found') + '</p>';
        }
      } catch(e) {
        resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>';
      }
    }
  </script>
</body>
</html>
