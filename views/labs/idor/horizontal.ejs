<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Horizontal PrivEsc - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1>🔓 Horizontal Privilege Escalation</h1><div class="lab-info"><span class="lab-tag difficulty-medium">Medium</span></div></div>
    <div class="lab-section">
      <h2><i class="fas fa-crosshairs"></i> Objective</h2>
      <p>Access top-secret classified documents that belong to the admin. The secrets API has no ownership verification.</p>
    </div>
    <div class="lab-section">
      <h2><i class="fas fa-terminal"></i> Secrets API</h2>
      <div class="vulnerable-form">
        <label>Secret ID (you own none):</label>
        <input type="number" id="secretId" value="1" autocomplete="off">
        <button onclick="getSecret()" class="btn btn-danger">Access Secret</button>
      </div>
      <div id="secretResult" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">API: GET /labs/idor/horizontal/secrets/{id}
Try IDs 1-3. Look for "top-secret" classification documents.</div>
    </div>
    <div class="flag-submit">
      <h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('idor-basic','flagInput_idor3','flagResult_idor3'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_idor3" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_idor3" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function getSecret() {
      const res = await fetch(`/labs/idor/horizontal/secrets/${document.getElementById('secretId').value}`);
      document.getElementById('secretResult').innerHTML = '<pre>'+JSON.stringify(await res.json(),null,2)+'</pre>';
    }
  </script>
</body>
</html>
