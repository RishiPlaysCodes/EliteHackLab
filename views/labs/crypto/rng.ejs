<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-dice"></i> Weak RNG Prediction</h1><div class="lab-info"><span class="lab-tag difficulty-hard">Hard</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2>
      <p>The server uses a weak pseudo-random number generator seeded with the current timestamp. Predict the next token to bypass authentication.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Token Generator</h2>
      <div class="vulnerable-form">
        <button class="btn" onclick="getToken()"><i class="fas fa-sync"></i> Get Current Token</button>
        <div style="margin-top:1rem;">
          <label for="predictedToken">Predicted Next Token:</label>
          <input type="text" id="predictedToken" placeholder="Enter your prediction">
          <button class="btn" onclick="submitPrediction()" style="margin-top:0.5rem;"><i class="fas fa-check"></i> Verify</button>
        </div>
      </div>
      <div id="rngResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# The server seeds Math.random() with Date.now()
# If you know the seed, you can predict all outputs

# Mersenne Twister can be cloned after 624 outputs
# Linear Congruential Generators are trivially predictable

# Get multiple tokens, find the pattern
# seed = timestamp in seconds: Math.floor(Date.now()/1000)
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('crypto-rng','flagInput_rng','flagResult_rng'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;">
        <input type="text" id="flagInput_rng" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_rng" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function getToken() {
      const resultsDiv = document.getElementById('rngResults');
      try {
        const res = await fetch('/api/labs/crypto/rng');
        const data = await res.json();
        resultsDiv.innerHTML = '<p>Current Token: <span style="color:#00ff00;font-family:monospace;">' + data.token + '</span></p><p style="color:var(--text-dim)">Generated at: ' + data.timestamp + '</p>';
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
    async function submitPrediction() {
      const predicted = document.getElementById('predictedToken').value;
      const resultsDiv = document.getElementById('rngResults');
      try {
        const res = await fetch('/api/labs/crypto/rng', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ predicted }) });
        const data = await res.json();
        if (data.correct) { resultsDiv.innerHTML = '<p style="color:#00ff00"><i class="fas fa-check-circle"></i> Correct prediction! ' + (data.flag||'') + '</p>'; }
        else { resultsDiv.innerHTML = '<p style="color:#ff4444"><i class="fas fa-times-circle"></i> Wrong prediction. Expected: ' + (data.expected||'???') + '</p>'; }
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
