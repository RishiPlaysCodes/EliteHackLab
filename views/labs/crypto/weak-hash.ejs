<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> - EliteHackLab</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></head>
<body>
  <div class="matrix-bg"></div>
  <nav class="main-nav"><div class="nav-brand"><span class="brand-icon">💀</span><span class="brand-text">Elite<span class="highlight">Hack</span>Lab</span></div><div class="nav-links"><a href="/"><i class="fas fa-home"></i> Dashboard</a></div></nav>
  <div class="lab-container">
    <div class="lab-header"><h1><i class="fas fa-hashtag"></i> Weak Hash Cracking</h1><div class="lab-info"><span class="lab-tag difficulty-easy">Easy</span></div></div>
    <div class="lab-section"><h2><i class="fas fa-crosshairs"></i> Objective</h2><p>Crack the following password hashes. They use weak hashing algorithms (MD5, SHA1) without salting. Find the plaintext passwords to get the flag.</p></div>
    <div class="lab-section"><h2><i class="fas fa-terminal"></i> Hash Cracker</h2>
      <div class="code-block">
        <h4>Target Hashes:</h4>
        <pre>
admin:5f4dcc3b5aa765d61d8327deb882cf99  (MD5)
user1:7c6a180b36896a65c4c202c1dc294543  (MD5)
root:8621ffdbc5698829397d97767ac13db3   (MD5)
        </pre>
      </div>
      <div class="vulnerable-form" style="margin-top:1rem;">
        <div style="margin-bottom:1rem;">
          <label for="hashInput">Hash to Crack:</label>
          <input type="text" id="hashInput" placeholder="5f4dcc3b5aa765d61d8327deb882cf99">
        </div>
        <div style="margin-bottom:1rem;">
          <label for="plaintextGuess">Plaintext Guess:</label>
          <input type="text" id="plaintextGuess" placeholder="password123">
        </div>
        <button class="btn" onclick="checkHash()"><i class="fas fa-unlock"></i> Check Hash</button>
      </div>
      <div id="hashResults" class="result-box" style="margin-top:1rem;"></div>
      <div class="code-block">
        <h4><i class="fas fa-lightbulb"></i> Hints</h4>
        <pre>
# Common tools:
hashcat -m 0 hashes.txt wordlist.txt    # MD5
john --format=raw-md5 hashes.txt

# Online rainbow tables work for unsalted hashes
# Try common passwords: password, admin, 123456
# The flag combines all three cracked passwords
        </pre>
      </div>
    </div>
    <div class="flag-submit"><h3><i class="fas fa-flag"></i> Capture The Flag</h3>
      <form onsubmit="submitFlagInline('crypto-weak-hash','flagInput_hash','flagResult_hash'); return false;" style="display:flex; gap:0.5rem; max-width:500px; margin:0 auto;"><input type="text" id="flagInput_hash" placeholder="FLAG{...}" autocomplete="off"><button type="submit" class="btn">Submit</button></form>
      <div id="flagResult_hash" style="display:none; margin-top:1rem;"></div>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <script>
    async function checkHash() {
      const hash = document.getElementById('hashInput').value;
      const plaintext = document.getElementById('plaintextGuess').value;
      const resultsDiv = document.getElementById('hashResults');
      resultsDiv.innerHTML = '<p style="color:var(--primary)"><i class="fas fa-spinner fa-spin"></i> Checking...</p>';
      try {
        const res = await fetch('/api/labs/crypto/weak-hash', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ hash, plaintext }) });
        const data = await res.json();
        if (data.match) {
          resultsDiv.innerHTML = '<p style="color:#00ff00"><i class="fas fa-check-circle"></i> Correct! "' + plaintext + '" matches the hash.</p>';
        } else {
          resultsDiv.innerHTML = '<p style="color:#ff4444"><i class="fas fa-times-circle"></i> Incorrect. That plaintext does not match the hash.</p>';
        }
      } catch(e) { resultsDiv.innerHTML = '<p style="color:#ff4444">Error: ' + e.message + '</p>'; }
    }
  </script>
</body>
</html>
